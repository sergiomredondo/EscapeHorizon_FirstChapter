<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEngine.UIElements.Experimental" editor-extension-mode="False">
    <Style src="project://database/Assets/_Project/UI/Styles/HUD.uss?fileID=7433441132597879392&amp;guid=46c5f35131f48844c985b28afd300693&amp;type=3#HUD"/>
    <ui:VisualElement name="hud-root" class="hud-root">
        <ui:VisualElement name="interaction-container" class="interaction-bar">
            <ui:Label name="interaction-label" text="Interactuar" class="interaction-label" style="font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/_Project/UI/Fonts/Tektur-VariableFont_wdth,wght.ttf?fileID=12800000&amp;guid=4f1027b2edfe59f4ebdd0bc0d3defbdb&amp;type=3#Tektur-VariableFont_wdth,wght&quot;); -unity-font-style: bold; color: rgb(229, 229, 229); top: -70px;"/>
            <ui:ProgressBar name="interaction-progress" low-value="0" high-value="100" class="interaction-progress-bar" style="top: -70px; width: 275px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
            <ui:Image name="Icon" style="background-image: url(&quot;project://database/Assets/_Project/Art_Sound/UI/Icons/Icons.png?fileID=999994177&amp;guid=5771eae6fba68db4db49a107e5503016&amp;type=3#Icons_10&quot;); width: 64px; height: 64px; top: -140px; left: -70px;"/>
        </ui:VisualElement>
        <ui:VisualElement name="mission-panel" class="corner-panel corner-panel--top-left">
            <ui:Label name="mission-label" text="" class="mission-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="minimap-panel" class="corner-panel corner-panel--top-right">
            <ui:Label name="minimap-placeholder-label" text="MAP" class="placeholder-label"/>
        </ui:VisualElement>
        <ui:VisualElement name="center-anchor" class="center-anchor">
            <ui:VisualElement name="crosshair" class="crosshair"/>
        </ui:VisualElement>
        <ui:VisualElement name="vitality-panel" class="vitality-panel">
            <ui:VisualElement name="energy-frame" class="vitality-frame vitality-frame--energy">
                <ui:Label text="Energía" class="vitality-system-label"/>
                <ui:ProgressBar name="energy-bar" low-value="0" high-value="100" class="vitality-bar vitality-bar--energy"/>
            </ui:VisualElement>
            <ui:VisualElement name="health-frame" class="vitality-frame vitality-frame--health">
                <ui:Label text="Integridad estructural" class="vitality-system-label"/>
                <ui:ProgressBar name="hp-bar" low-value="0" high-value="100" class="vitality-bar vitality-bar--hp"/>
            </ui:VisualElement>
            <ui:VisualElement name="vitality-metrics" class="vitality-metrics-panel"/>
        </ui:VisualElement>
        <ui:VisualElement name="resources-panel" class="resources-panel">
            <ui:VisualElement name="resource-metrics" class="resource-metrics-panel">
                <ui:VisualElement name="scrap-group" class="resource-group">
                    <ui:Label text="SC:" class="resource-metric-label" style="color: rgb(0, 204, 204);"/>
                    <ui:Label name="scrap-label" text="0000" class="resource-metric-value"/>
                </ui:VisualElement>
                <ui:VisualElement name="cores-group" class="resource-group">
                    <ui:Label text="IC:" class="resource-metric-label" style="color: rgb(0, 204, 204);"/>
                    <ui:Label name="ic-label" text="00" class="resource-metric-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="separator"/>
            <ui:VisualElement name="surge-frame" class="resources-frame resources-frame--surge">
                <ui:Label text="Sistema Sobrecarga" class="resources-system-label"/>
                <ui:VisualElement name="surge-bar-row" class="surge-bar-row">
                    <ui:VisualElement name="surge-dot-cooldown" class="surge-status-dot surge-status-dot--cooldown"/>
                    <ui:VisualElement name="surge-dot-active" class="surge-status-dot surge-status-dot--active"/>
                    <ui:ProgressBar name="surge-bar" low-value="0" high-value="100" class="resources-bar resources-bar--surge"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="reticle-focus" class="reticle-focus focus-faded">
            <ui:VisualElement name="cooldown-arc-light" class="cooldown-arc cooldown-arc--light">
                <ui:VisualElement class="arc-mask-container">
                    <ui:VisualElement name="arc-fill-light" class="arc-fill"/>
                </ui:VisualElement>
                <ui:Image name="Icon" style="height: 10%; width: 10%; background-image: url(&quot;project://database/Assets/_Project/Art_Sound/UI/Icons/LightAttack.png?fileID=2800000&amp;guid=8d9622995561d5d4e95c39b6669ba7da&amp;type=3#LightAttack&quot;); top: -12%; left: 30%;">
                    <ui:Image name="line" style="background-image: url(&quot;project://database/Assets/_Project/Art_Sound/UI/Icons/LineLightAttack.png?fileID=2800000&amp;guid=7db5300306c4a874c896a486c68a66d2&amp;type=3#LineLightAttack&quot;); height: 25px; width: 45px; left: 20px; top: 20px;"/>
                </ui:Image>
            </ui:VisualElement>
            <ui:VisualElement name="cooldown-arc-heavy" class="cooldown-arc cooldown-arc--heavy">
                <ui:VisualElement class="arc-mask-container">
                    <ui:VisualElement name="arc-fill-heavy" class="arc-fill"/>
                </ui:VisualElement>
                <ui:Image name="Icon" style="height: 10%; width: 10%; background-image: url(&quot;project://database/Assets/_Project/Art_Sound/UI/Icons/HeavyAttack.png?fileID=2800000&amp;guid=eb28dc3c2e5d1474294457066653a169&amp;type=3#HeavyAttack&quot;); top: -12%; left: 20%;">
                    <ui:Image name="line" style="background-image: url(&quot;project://database/Assets/_Project/Art_Sound/UI/Icons/LineHeavyAttack.png?fileID=2800000&amp;guid=34aa83d2ae37dc248a73deaa166cbafd&amp;type=3#LineHeavyAttack&quot;); height: 30px; width: 76px; left: 20px; top: 18px;"/>
                </ui:Image>
            </ui:VisualElement>
            <ui:VisualElement name="cooldown-arc-dash" class="cooldown-arc cooldown-arc--dash">
                <ui:VisualElement class="arc-mask-container">
                    <ui:VisualElement name="arc-fill-dash" class="arc-fill"/>
                </ui:VisualElement>
                <ui:Image name="Icon" style="height: 10%; width: 10%; background-image: url(&quot;project://database/Assets/_Project/Art_Sound/UI/Icons/Dash.png?fileID=2800000&amp;guid=50563d698c71fab468abbd8d9142ba9d&amp;type=3#Dash&quot;); top: -11%; left: 10%;">
                    <ui:Image name="line" style="background-image: url(&quot;project://database/Assets/_Project/Art_Sound/UI/Icons/LineDash.png?fileID=2800000&amp;guid=034067eed67d08d49829c8abbb69522f&amp;type=3#LineDash&quot;); height: 30px; width: 100px; left: 28px; top: 16px;"/>
                </ui:Image>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="build-readonly-notice" text="[ Return to base to modify build ]" class="build-readonly-notice" style="display: none;"/>
        <ui:Label name="build-purge-notice" text="[ Insufficient Identity Cores for purification ]" class="build-purge-notice" style="display: none;"/>
        <ui:VisualElement name="build-menu-overlay" class="build-menu-overlay" style="display: none;">
            <ui:VisualElement name="build-menu-panel" class="build-menu-panel">
                <ui:Label name="build-menu-title" text="ANALYSIS TREE" class="build-menu-title"/>
                <ui:VisualElement class="separator"/>
                <ui:VisualElement name="build-resources-row" class="build-resources-row">
                    <ui:Label name="build-label-hp" text="HP: —" class="build-resource-chip build-resource-chip--hp"/>
                    <ui:Label name="build-label-energy" text="EN: —" class="build-resource-chip build-resource-chip--energy"/>
                    <ui:Label name="build-label-scrap" text="SC: 0" class="build-resource-chip build-resource-chip--scrap"/>
                    <ui:Label name="build-label-ic" text="IC: 0" class="build-resource-chip build-resource-chip--ic"/>
                    <ui:Label name="build-label-pd" text="PD: 0" class="build-resource-chip build-resource-chip--pd"/>
                </ui:VisualElement>
                <ui:VisualElement name="build-purge-section" class="build-purge-section" style="display: none;">
                    <ui:VisualElement class="build-purge-header-row">
                        <ui:Label name="build-purge-title" text="PURIFY CORES" class="build-purge-title"/>
                        <ui:Label name="build-purge-yield" text="" class="build-purge-yield"/>
                    </ui:VisualElement>
                    <ui:Button name="build-purge-btn" text="PURGE" class="build-purge-btn"/>
                </ui:VisualElement>
                <ui:VisualElement class="separator"/>
                <ui:VisualElement name="build-tree-columns" class="build-tree-columns">
                    <ui:VisualElement name="branch-attack" class="build-branch-column">
                        <ui:Label text="ATTACK" class="build-branch-header build-branch-header--attack"/>
                        <ui:Button name="node-attack-0" text="—" class="build-node-btn"/>
                        <ui:Button name="node-attack-1" text="—" class="build-node-btn"/>
                        <ui:Button name="node-attack-2" text="—" class="build-node-btn"/>
                        <ui:Button name="node-attack-3" text="—" class="build-node-btn"/>
                        <ui:Button name="node-attack-4" text="—" class="build-node-btn"/>
                        <ui:Button name="reanalysis-attack" text="SWITCH" class="build-reanalysis-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="branch-defense" class="build-branch-column">
                        <ui:Label text="DEFENSE" class="build-branch-header build-branch-header--defense"/>
                        <ui:Button name="node-defense-0" text="—" class="build-node-btn"/>
                        <ui:Button name="node-defense-1" text="—" class="build-node-btn"/>
                        <ui:Button name="node-defense-2" text="—" class="build-node-btn"/>
                        <ui:Button name="node-defense-3" text="—" class="build-node-btn"/>
                        <ui:Button name="node-defense-4" text="—" class="build-node-btn"/>
                        <ui:Button name="reanalysis-defense" text="SWITCH" class="build-reanalysis-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="branch-agility" class="build-branch-column">
                        <ui:Label text="AGILITY" class="build-branch-header build-branch-header--agility"/>
                        <ui:Button name="node-agility-0" text="—" class="build-node-btn"/>
                        <ui:Button name="node-agility-1" text="—" class="build-node-btn"/>
                        <ui:Button name="node-agility-2" text="—" class="build-node-btn"/>
                        <ui:Button name="node-agility-3" text="—" class="build-node-btn"/>
                        <ui:Button name="node-agility-4" text="—" class="build-node-btn"/>
                        <ui:Button name="reanalysis-agility" text="SWITCH" class="build-reanalysis-btn"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="separator"/>
                <ui:Label name="build-reanalysis-cost" text="" class="build-reanalysis-cost-label"/>
                <ui:VisualElement name="build-narrative-panel" class="build-narrative-panel" style="display: none;">
                    <ui:Label name="build-narrative-text" text="" class="build-narrative-text"/>
                </ui:VisualElement>
                <ui:VisualElement class="separator"/>
                <ui:Button name="build-close-btn" text="CLOSE  [ TAB ]" class="build-close-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="datalog-overlay" class="datalog-overlay" style="display: none;">
            <ui:VisualElement name="datalog-panel" class="datalog-panel">
                <ui:Label name="datalog-tag" text="DATA LOG" class="datalog-tag"/>
                <ui:Label name="datalog-title" text="" class="datalog-title"/>
                <ui:Label name="datalog-source" text="" class="datalog-source"/>
                <ui:VisualElement class="separator"/>
                <ui:ScrollView name="datalog-body-scroll" vertical-scroller-visibility="Auto" class="datalog-body-scroll">
                    <ui:Label name="datalog-body" text="" class="datalog-body"/>
                </ui:ScrollView>
                <ui:VisualElement class="separator"/>
                <ui:Button name="datalog-close-btn" text="CLOSE  [ E ]" class="build-close-btn"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
