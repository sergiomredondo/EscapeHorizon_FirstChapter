:root {
    --color-cyan: rgb(0, 255, 255);
    --color-magenta: rgb(255, 0, 255);
    --color-orange: rgb(255, 100, 0);
    --color-yellow: rgb(255, 204, 0);
    --color-hp-fill: rgb(0, 119, 229);
    --color-white: rgb(224, 224, 224);
    --color-panel-bg: rgba(10, 10, 10, 0.72);
    --color-bar-track: rgba(30, 30, 30, 0.9);
    --color-border: rgba(0, 255, 255, 0.3);
    --color-placeholder: rgba(80, 80, 80, 0.6);
    --font-size-normal: 14px;
    --font-size-small: 11px;
    --font-size-large: 18px;
    --bar-height-min: 10px;
    --bar-height-max: 30px;
    --bar-width-min: 250px;
    --bar-width-max: 400px;
    --bar-width-fix: 270px;
    --bar-border-radius: 3px;
    --panel-padding: 10px;
    --panel-margin: 25px;
    --panel-border-width: 3px;
    --panel-border-radius: 5px;
    --cooldown-arc-size: 320px;
    --cooldown-arc-thickness: 10px;
    --cooldown-arc-color-light: var(--color-cyan);
    --cooldown-arc-color-heavy: var(--color-cyan);
    --cooldown-arc-color-dash: var(--color-cyan);
    --cooldown-arc-opacity-ready: 0.25;
    --cooldown-arc-opacity-active: 1;
    --focus-transition-duration: 0.25s;
    --icon-label-width: 28px;
    --surge-dot-size: 12px;
    --crosshair-size: 6px;
    --opacity-zone-c: 0.55;
    --build-column-width: 160px;
    --build-node-height: 42px;
    --color-attack: rgb(210, 60, 60);
    --color-defense: rgb(60, 140, 210);
    --color-agility: rgb(60, 200, 120);
    --transition-duration: 0.15s;
    --regular-font: url("project://database/Assets/_Project/UI/Fonts/Tektur-VariableFont_wdth,wght.ttf?fileID=12800000&guid=4f1027b2edfe59f4ebdd0bc0d3defbdb&type=3#Tektur-VariableFont_wdth,wght");
    --hundred: 1;
    --ninety: 0.9;
    --eighty: 0.8;
    --seventy: 0.7;
    --sixty: 0.6;
    --fifty: 0.5;
    --fourty: 0.4;
    --thirty: 0.3;
    --twenty: 0.2;
    --ten: 0.1;
    --eight: 0.08;
    --five: 0.05;
    --three: 0.03;
    --one: 0.01;
    --zero: 0;
    --hundred-px: 100px;
    --eighty-px: 80px;
    --sisty-px: 60px;
    --fifty-px: 50px;
    --forty-px: 40px;
    --thirty-px: 30px;
    --twenty-px: 20px;
    --ten-px: 10px;
    --five-px: 5px;
    --one-px: 1px;
    --zero-px: 0;
    -unity-font-definition: var(--regular-font);
}

.hud-root {
    position: absolute;
    height: var(--hundred);
    width: var(--hundred);
    left: var(--zero-px);
    top: var(--zero-px);
    right: var(--zero-px);
    bottom: var(--zero-px);
    color: var(--color-white);
    -unity-overflow-clip-box: content-box;
    -unity-font-definition: var(--regular-font);
    font-size: var(--font-size-normal);
    opacity: var(--ninety);
}

.center-anchor {
    position: absolute;
    left: var(--fifty);
    top: var(--fifty);
    width: var(--zero-px);
    height: var(--zero-px);
}

.separator {
    height: var(--panel-border-width);
    background-color: var(--color-cyan);
    margin-top: var(--five-px);
    margin-bottom: var(--four-px);
}

.vitality-panel {
    position: absolute;
    bottom: var(--panel-margin);
    left: var(--panel-margin);
    padding: var(--panel-padding);
    background-color: var(--color-panel-bg);
    border-width: var(--panel-border-width);
    border-color: var(--color-border);
    border-radius: var(--panel-border-radius);
    flex-direction: column;
    align-items: flex-start;
}

.vitality-frame {
    flex-direction: column;
    margin-bottom: var(--row-spacing);
    width: auto;
}

.vitality-frame--energy {
    margin-left: var(--zero-px);
}

.vitality-frame--health {
    margin-left: var(--twenty-px);
    margin-bottom: var(--zero-px);
}

.vitality-system-label {
    font-size: var(--font-size-small);
    color: var(--color-white);
    -unity-font-style: bold;
    letter-spacing: var(--one-px);
    margin-bottom: var(--five-px);
    white-space: nowrap;
}

.vitality-bar {
    margin: var(--zero-px);
    padding: var(--zero-px);
    min-height: var(--bar-height-min);
    max-height: var(--bar-height-max);
    min-width: var(--bar-width-min);
    max-width: var(--bar-width-max);
}

.vitality-bar--hp {
    margin-left: var(--ten-px);
}

.vitality-bar .unity-progress-bar__container {
    border-width: var(--zero-px);
}

.vitality-bar .unity-progress-bar__background {
    background-color: var(--color-bar-track);
    border-width: var(--panel-border-width);
    border-color: var(--color-border);
    border-radius: var(--bar-border-radius);
}

.vitality-bar--energy .unity-progress-bar__progress {
    background-color: var(--color-yellow);
    border-radius: var(--bar-border-radius);
}

.vitality-bar--hp .unity-progress-bar__progress {
    background-color: var(--color-hp-fill);
    border-radius: var(--bar-border-radius);
}

.vitality-metrics-panel {
    flex-direction: row;
    justify-content: flex-end;
    width: var(--hundred);
}

.resources-panel {
    position: absolute;
    bottom: var(--panel-margin);
    right: var(--panel-margin);
    padding: var(--panel-padding);
    background-color: var(--color-panel-bg);
    border-width: var(--panel-border-width);
    border-color: var(--color-border);
    border-radius: var(--panel-border-radius);
    flex-direction: column;
    align-items: flex-end;
}

.resource-metrics-panel {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    margin-bottom: var(--five-px);
}

.resource-group {
    flex-direction: row;
    align-items: center;
    margin-left: var(--forty-px);
}

.resource-metric-label {
    font-size: var(--font-size-small);
    color: var(--color-placeholder);
    -unity-font-style: bold;
    margin-right: var(--five-px);
}

.resource-metric-value {
    font-size: var(--font-size-large);
    color: var(--color-white);
    -unity-font-style: bold;
    letter-spacing: var(--one-px);
}

.resources-frame {
    flex-direction: column;
    align-items: flex-end;
    width: auto;
}

.resources-frame--surge {
    margin-top: var(--five-px);
    margin-right: var(--zero-px);
    margin-left: var(--twenty-px);
}

.resources-system-label {
    font-size: var(--font-size-small);
    color: var(--color-white);
    -unity-font-style: bold;
    letter-spacing: var(--one-px);
    margin-bottom: var(--five-px);
    white-space: nowrap;
}

.surge-bar-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.surge-status-dot {
    width: var(--surge-dot-size);
    height: var(--surge-dot-size);
    border-radius: var(--five-px);
    border-width: var(--panel-border-width);
    border-color: rgba(10, 10, 10, 0.5);
    margin-right: var(--five-px);
    background-color: rgba(40, 40, 40, 0.8);
}

.surge-status-dot--cooldown.surge-cooldown {
    background-color: var(--color-orange);
}

.surge-status-dot--active.surge-active {
    background-color: var(--color-magenta);
}

.resources-bar {
    margin: var(--zero-px);
    padding: var(--zero-px);
    min-height: var(--bar-height-min);
    max-height: var(--bar-height-max);
    width: var(--bar-width-fix);
}

.resources-bar .unity-progress-bar__container {
    border-width: var(--zero-px);
}

.resources-bar .unity-progress-bar__background {
    background-color: var(--color-bar-track);
    border-width: var(--panel-border-width);
    border-color: var(--color-border);
    border-radius: var(--bar-border-radius);
}

.resources-bar--surge .unity-progress-bar__progress {
    border-radius: var(--bar-border-radius);
    background-color: var(--color-orange);
}

.reticle-focus {
    width: var(--cooldown-arc-size);
    height: var(--cooldown-arc-size);
    transition-property: opacity;
    transition-duration: var(--focus-transition-duration);
    position: absolute;
    top: 50%;
    left: 50%;
    scale: 1 1;
    translate: 40% -50%;
}

.reticle-focus.focus-faded {
    opacity: var(--cooldown-arc-opacity-ready);
}

.reticle-focus.focus-active {
    opacity: var(--cooldown-arc-opacity-active);
}

.cooldown-arc {
    position: absolute;
    width: var(--cooldown-arc-size);
    height: var(--cooldown-arc-size);
    border-radius: 50%;
    border-width: var(--cooldown-arc-thickness);
    border-color: rgba(255, 255, 255, 0.12);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    rotate: 0;
}

.cooldown-arc--light {
    left: 50px;
    scale: 1.2;
}

.cooldown-arc--heavy {
    left: 50px;
    scale: 1.1;
}

.cooldown-arc--dash {
    left: 50px;
    scale: 1;
}

.arc-mask-container {
    position: absolute;
    width: 50%;
    height: 100%;
    overflow: hidden;
    border-width: var(--cooldown-arc-thickness);
    align-items: flex-end;
    justify-content: flex-start;
    rotate: 0;
    align-self: flex-end;
    align-content: flex-start;
    flex-direction: column;
    top: auto;
    left: auto;
    right: auto;
    bottom: auto;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.arc-fill {
    position: absolute;
    width: var(--cooldown-arc-size);
    height: var(--cooldown-arc-size);
    border-radius: 50%;
    border-width: var(--cooldown-arc-thickness);
    border-color: transparent;
    transform-origin: center;
    rotate: -45deg;
}

.cooldown-arc--light .arc-fill {
    border-right-color: var(--cooldown-arc-color-light);
    border-bottom-color: var(--cooldown-arc-color-light);
}

.cooldown-arc--heavy .arc-fill {
    border-right-color: var(--cooldown-arc-color-heavy);
    border-bottom-color: var(--cooldown-arc-color-heavy);
}

.cooldown-arc--dash .arc-fill {
    border-right-color: var(--cooldown-arc-color-dash);
    border-bottom-color: var(--cooldown-arc-color-dash);
}

.build-menu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.78);
    align-items: center;
    justify-content: center;
}

.build-menu-panel {
    background-color: var(--color-panel-bg);
    border-color: var(--color-border);
    border-width: var(--panel-border-width);
    border-radius: var(--panel-border-radius);
    padding: 20px;
    min-width: 560px;
    max-width: 680px;
}

.build-readonly-notice {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    opacity: 0.8;
    margin-bottom: 6px;
}

.build-readonly-notice,
.build-purge-notice {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    opacity: 0.8;
    margin-bottom: 6px;
    transition: opacity 0.4s ease-out;
}

.build-menu-title {
    font-size: var(--font-size-large);
    color: var(--color-cyan);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.build-resources-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 8px;
}

.build-resource-chip {
    font-size: var(--font-size-small);
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-radius: 2px;
    padding: 2px 6px;
    flex-grow: 1;
    margin-right: 4px;
}

.build-resource-chip--hp {
    color: var(--color-hp-fill);
}

.build-resource-chip--energy {
    color: var(--color-cyan);
}

.build-resource-chip--scrap {
    color: var(--color-yellow);
}

.build-resource-chip--ic {
    color: var(--color-cyan);
}

.build-resource-chip--pd {
    color: var(--color-white);
}

.build-tree-columns {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
    margin-bottom: 10px;
}

.build-branch-column {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    margin-right: 8px;
}

.build-branch-column:last-child {
    margin-right: 0;
}

.build-branch-header {
    font-size: var(--font-size-small);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 6px;
    padding: 2px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.build-branch-header--attack {
    color: rgb(210, 60, 60);
}

.build-branch-header--defense {
    color: rgb(60, 140, 210);
}

.build-branch-header--agility {
    color: rgb(60, 200, 120);
}

.build-node-btn {
    font-size: var(--font-size-small);
    height: 42px;
    margin-bottom: 4px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.04);
    color: var(--color-placeholder);
    -unity-text-align: middle-center;
    white-space: normal;
    transition: background-color var(--transition-duration) ease-out, border-color var(--transition-duration) ease-out, color var(--transition-duration) ease-out;
}

.build-node-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
}

.build-node-btn--active {
    background-color: rgba(0, 255, 180, 0.15);
    border-color: rgba(0, 255, 180, 0.55);
    color: rgb(0, 255, 180);
}

.build-node-btn--next {
    background-color: rgba(255, 204, 0, 0.08);
    border-color: rgba(255, 204, 0, 0.45);
    color: var(--color-yellow);
}

.build-node-btn--unavailable {
    background-color: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.05);
    color: rgba(80, 80, 80, 0.6);
    opacity: 0.5;
}

.build-reanalysis-btn {
    font-size: var(--font-size-small);
    height: 28px;
    margin-top: 4px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: rgba(255, 100, 0, 0.35);
    background-color: rgba(255, 100, 0, 0.08);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    transition: background-color var(--transition-duration) ease-out, border-color var(--transition-duration) ease-out;
}

.build-reanalysis-btn:hover {
    background-color: rgba(255, 100, 0, 0.2);
    border-color: rgba(255, 100, 0, 0.65);
}

.build-reanalysis-btn:disabled {
    opacity: 0.3;
}

.build-reanalysis-cost-label {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 4px;
    opacity: 0.75;
}

.build-narrative-panel {
    background-color: rgba(0, 255, 255, 0.04);
    border-color: rgba(0, 255, 255, 0.15);
    border-width: 1px;
    border-radius: var(--panel-border-radius);
    padding: 10px;
    margin-top: 8px;
    margin-bottom: 4px;
}

.build-narrative-text {
    font-size: var(--font-size-small);
    color: var(--color-white);
    -unity-text-align: upper-left;
    white-space: normal;
    opacity: 0.85;
}

.build-purge-section {
    flex-direction: column;
    background-color: rgba(0, 255, 180, 0.04);
    border-color: rgba(0, 255, 180, 0.18);
    border-width: 1px;
    border-radius: var(--panel-border-radius);
    padding: 8px 10px;
    margin-top: 8px;
    margin-bottom: 4px;
}

.build-purge-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.build-purge-title {
    font-size: var(--font-size-small);
    color: rgb(0, 255, 180);
    -unity-font-style: bold;
}

.build-purge-yield {
    font-size: var(--font-size-small);
    color: var(--color-white);
    -unity-text-align: middle-right;
    opacity: 0.8;
}

.build-purge-btn {
    font-size: var(--font-size-small);
    height: 32px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: rgba(0, 255, 180, 0.45);
    background-color: rgba(0, 255, 180, 0.1);
    color: rgb(0, 255, 180);
    -unity-text-align: middle-center;
    transition: background-color var(--transition-duration) ease-out, border-color var(--transition-duration) ease-out;
}

.build-purge-btn:hover {
    background-color: rgba(0, 255, 180, 0.22);
    border-color: rgba(0, 255, 180, 0.75);
}

.build-purge-btn:disabled {
    opacity: 0.3;
}

.build-purge-notice {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    opacity: 0.8;
    margin-bottom: 6px;
}

.build-close-btn {
    font-size: var(--font-size-small);
    height: 32px;
    margin-top: 8px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: var(--color-border);
    background-color: rgba(0, 255, 255, 0.06);
    color: var(--color-cyan);
    -unity-text-align: middle-center;
    transition: background-color var(--transition-duration) ease-out;
}

.build-close-btn:hover {
    background-color: rgba(0, 255, 255, 0.15);
}
