:root {
    --color-cyan: rgb(0, 255, 255);
    --color-magenta: rgb(255, 0, 255);
    --color-orange: rgb(255, 100, 0);
    --color-yellow: rgb(255, 204, 0);
    --color-hp-fill: rgb(210, 45, 45);
    --color-white: rgb(224, 224, 224);
    --color-panel-bg: rgba(10, 10, 10, 0.72);
    --color-bar-track: rgba(30, 30, 30, 0.9);
    --color-border: rgba(0, 255, 255, 0.3);
    --color-placeholder: rgba(80, 80, 80, 0.6);
    --font-size-normal: 13px;
    --font-size-small: 11px;
    --font-size-large: 16px;
    --bar-height: 10px;
    --bar-width: 220px;
    --bar-border-radius: 2px;
    --panel-padding: 10px;
    --panel-margin: 16px;
    --panel-border-width: 1px;
    --panel-border-radius: 3px;
    --row-spacing: 6px;
    --icon-label-width: 28px;
    --surge-dot-size: 12px;
    --crosshair-size: 6px;
    --opacity-zone-c: 0.55;
    --build-column-width: 160px;
    --build-node-height: 42px;
    --color-attack: rgb(210, 60, 60);
    --color-defense: rgb(60, 140, 210);
    --color-agility: rgb(60, 200, 120);
    --transition-duration: 0.15s;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Tektur-VariableFont_wdth,wght.ttf?fileID=12800000&guid=4f1027b2edfe59f4ebdd0bc0d3defbdb&type=3#Tektur-VariableFont_wdth,wght");
}

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-overflow-clip-box: content-box;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Tektur-VariableFont_wdth,wght.ttf?fileID=12800000&guid=4f1027b2edfe59f4ebdd0bc0d3defbdb&type=3#Tektur-VariableFont_wdth,wght");
    font-size: 14px;
    display: flex;
    visibility: visible;
}

.corner-panel {
    position: absolute;
    background-color: var(--color-panel-bg);
    border-color: var(--color-border);
    border-width: var(--panel-border-width);
    border-radius: var(--panel-border-radius);
    padding: var(--panel-padding);
    min-width: 260px;
    -unity-font-definition: url("project://database/Assets/_Project/UI/Fonts/Tektur-VariableFont_wdth,wght.ttf?fileID=12800000&guid=4f1027b2edfe59f4ebdd0bc0d3defbdb&type=3#Tektur-VariableFont_wdth,wght");
}

.corner-panel--bottom-left {
    left: var(--panel-margin);
    bottom: var(--panel-margin);
    background-image: url("/Assets/UI/Icons/panel-vitality-frame.svg");
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.corner-panel--bottom-right {
    right: var(--panel-margin);
    bottom: var(--panel-margin);
}

.corner-panel--top-left {
    left: var(--panel-margin);
    top: var(--panel-margin);
    opacity: var(--opacity-zone-c);
}

.corner-panel--top-right {
    right: var(--panel-margin);
    top: var(--panel-margin);
    opacity: var(--opacity-zone-c);
}

.center-anchor {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.crosshair {
    position: absolute;
    width: var(--crosshair-size);
    height: var(--crosshair-size);
    left: -3px;
    top: -3px;
    border-radius: 50%;
    background-color: rgba(0, 255, 255, 0.7);
    border-color: rgba(0, 255, 255, 0.4);
    border-width: 1px;
}

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--row-spacing);
    width: 100%;
}

.bar-icon-label {
    width: var(--icon-label-width);
    font-size: var(--font-size-small);
    -unity-text-align: middle-left;
    flex-shrink: 0;
    margin-right: 6px;
}

.bar-icon-label--hp {
    color: var(--color-hp-fill);
}

.bar-icon-label--energy {
    color: var(--color-cyan);
}

.resource-bar {
    flex-grow: 1;
    height: var(--bar-height);
    border-width: 0;
    border-radius: var(--bar-border-radius);
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.resource-bar > .unity-progress-bar__background {
    background-color: var(--color-bar-track);
    border-radius: var(--bar-border-radius);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    background-image: url("project://database/Assets/Preselected/SciFi%20Assets/Sprites/vector_4/Vector_7.png?fileID=2800000&guid=8c76d139fc8f53b4d8920d458235e8df&type=3#Vector_7");
}

.resource-bar > .unity-progress-bar__progress {
    border-radius: var(--bar-border-radius);
    transition: width var(--transition-duration) ease-out;
}

.resource-bar--hp > .unity-progress-bar__progress {
    background-color: var(--color-hp-fill);
}

.resource-bar--hp.bar--critical > .unity-progress-bar__progress {
    background-color: rgb(255, 60, 60);
}

.resource-bar--energy > .unity-progress-bar__progress {
    background-color: var(--color-cyan);
}

.corner-panel--bottom-right.surge-active #energy-bar > .unity-progress-bar__progress {
    background-color: var(--color-magenta);
}

.corner-panel--bottom-right.surge-cooldown #energy-bar > .unity-progress-bar__progress {
    background-color: var(--color-orange);
}

.resource-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--row-spacing);
}

.resource-label {
    font-size: var(--font-size-normal);
    -unity-text-align: middle-left;
}

.resource-label--scrap {
    color: var(--color-yellow);
}

.resource-label--ic {
    color: var(--color-cyan);
}

.surge-indicator {
    flex-direction: row;
    align-items: center;
    width: var(--surge-dot-size);
    height: var(--surge-dot-size);
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    transition: background-color var(--transition-duration) ease-out, border-color var(--transition-duration) ease-out, width var(--transition-duration) ease-out;
}

.surge-indicator.surge-active {
    background-color: var(--color-magenta);
    border-color: rgb(255, 100, 255);
    width: 72px;
}

.surge-indicator.surge-cooldown {
    background-color: var(--color-orange);
    border-color: rgb(255, 160, 80);
    width: 72px;
}

.surge-state-label {
    font-size: var(--font-size-small);
    color: rgb(240, 240, 240);
    -unity-text-align: middle-center;
    opacity: 0;
    flex-grow: 1;
    overflow: hidden;
    transition: opacity var(--transition-duration) ease-out;
}

.surge-indicator.surge-active > .surge-state-label,
.surge-indicator.surge-cooldown > .surge-state-label {
    opacity: 1;
}

.mission-label {
    font-size: var(--font-size-normal);
    color: var(--color-white);
    -unity-text-align: upper-left;
    white-space: normal;
}

.minimap-panel {
    min-width: 80px;
    min-height: 80px;
}

.placeholder-label {
    font-size: var(--font-size-small);
    color: var(--color-placeholder);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.separator {
    height: 1px;
    background-color: rgba(0, 255, 255, 0.12);
    margin-top: 4px;
    margin-bottom: 4px;
}

.build-menu-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.78);
    align-items: center;
    justify-content: center;
}

.build-menu-panel {
    background-color: var(--color-panel-bg);
    border-color: var(--color-border);
    border-width: var(--panel-border-width);
    border-radius: var(--panel-border-radius);
    padding: 20px;
    min-width: 560px;
    max-width: 680px;
}

.build-readonly-notice {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    opacity: 0.8;
    margin-bottom: 6px;
}

.build-readonly-notice,
.build-purge-notice {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    opacity: 0.8;
    margin-bottom: 6px;
    transition: opacity 0.4s ease-out;
}

.build-menu-title {
    font-size: var(--font-size-large);
    color: var(--color-cyan);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.build-resources-row {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 8px;
}

.build-resource-chip {
    font-size: var(--font-size-small);
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-radius: 2px;
    padding: 2px 6px;
    flex-grow: 1;
    margin-right: 4px;
}

.build-resource-chip--hp {
    color: var(--color-hp-fill);
}

.build-resource-chip--energy {
    color: var(--color-cyan);
}

.build-resource-chip--scrap {
    color: var(--color-yellow);
}

.build-resource-chip--ic {
    color: var(--color-cyan);
}

.build-resource-chip--pd {
    color: var(--color-white);
}

.build-tree-columns {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
    margin-bottom: 10px;
}

.build-branch-column {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    margin-right: 8px;
}

.build-branch-column:last-child {
    margin-right: 0;
}

.build-branch-header {
    font-size: var(--font-size-small);
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    margin-bottom: 6px;
    padding: 2px 0;
    border-bottom-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.build-branch-header--attack {
    color: rgb(210, 60, 60);
}

.build-branch-header--defense {
    color: rgb(60, 140, 210);
}

.build-branch-header--agility {
    color: rgb(60, 200, 120);
}

.build-node-btn {
    font-size: var(--font-size-small);
    height: 42px;
    margin-bottom: 4px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.04);
    color: var(--color-placeholder);
    -unity-text-align: middle-center;
    white-space: normal;
    transition: background-color var(--transition-duration) ease-out, border-color var(--transition-duration) ease-out, color var(--transition-duration) ease-out;
}

.build-node-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.25);
}

.build-node-btn--active {
    background-color: rgba(0, 255, 180, 0.15);
    border-color: rgba(0, 255, 180, 0.55);
    color: rgb(0, 255, 180);
}

.build-node-btn--next {
    background-color: rgba(255, 204, 0, 0.08);
    border-color: rgba(255, 204, 0, 0.45);
    color: var(--color-yellow);
}

.build-node-btn--unavailable {
    background-color: rgba(255, 255, 255, 0.02);
    border-color: rgba(255, 255, 255, 0.05);
    color: rgba(80, 80, 80, 0.6);
    opacity: 0.5;
}

.build-reanalysis-btn {
    font-size: var(--font-size-small);
    height: 28px;
    margin-top: 4px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: rgba(255, 100, 0, 0.35);
    background-color: rgba(255, 100, 0, 0.08);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    transition: background-color var(--transition-duration) ease-out, border-color var(--transition-duration) ease-out;
}

.build-reanalysis-btn:hover {
    background-color: rgba(255, 100, 0, 0.2);
    border-color: rgba(255, 100, 0, 0.65);
}

.build-reanalysis-btn:disabled {
    opacity: 0.3;
}

.build-reanalysis-cost-label {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    margin-top: 4px;
    margin-bottom: 4px;
    opacity: 0.75;
}

.build-narrative-panel {
    background-color: rgba(0, 255, 255, 0.04);
    border-color: rgba(0, 255, 255, 0.15);
    border-width: 1px;
    border-radius: var(--panel-border-radius);
    padding: 10px;
    margin-top: 8px;
    margin-bottom: 4px;
}

.build-narrative-text {
    font-size: var(--font-size-small);
    color: var(--color-white);
    -unity-text-align: upper-left;
    white-space: normal;
    opacity: 0.85;
}

.build-purge-section {
    flex-direction: column;
    background-color: rgba(0, 255, 180, 0.04);
    border-color: rgba(0, 255, 180, 0.18);
    border-width: 1px;
    border-radius: var(--panel-border-radius);
    padding: 8px 10px;
    margin-top: 8px;
    margin-bottom: 4px;
}

.build-purge-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.build-purge-title {
    font-size: var(--font-size-small);
    color: rgb(0, 255, 180);
    -unity-font-style: bold;
}

.build-purge-yield {
    font-size: var(--font-size-small);
    color: var(--color-white);
    -unity-text-align: middle-right;
    opacity: 0.8;
}

.build-purge-btn {
    font-size: var(--font-size-small);
    height: 32px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: rgba(0, 255, 180, 0.45);
    background-color: rgba(0, 255, 180, 0.1);
    color: rgb(0, 255, 180);
    -unity-text-align: middle-center;
    transition: background-color var(--transition-duration) ease-out, border-color var(--transition-duration) ease-out;
}

.build-purge-btn:hover {
    background-color: rgba(0, 255, 180, 0.22);
    border-color: rgba(0, 255, 180, 0.75);
}

.build-purge-btn:disabled {
    opacity: 0.3;
}

.build-purge-notice {
    font-size: var(--font-size-small);
    color: var(--color-orange);
    -unity-text-align: middle-center;
    opacity: 0.8;
    margin-bottom: 6px;
}

.build-close-btn {
    font-size: var(--font-size-small);
    height: 32px;
    margin-top: 8px;
    border-radius: var(--panel-border-radius);
    border-width: 1px;
    border-color: var(--color-border);
    background-color: rgba(0, 255, 255, 0.06);
    color: var(--color-cyan);
    -unity-text-align: middle-center;
    transition: background-color var(--transition-duration) ease-out;
}

.build-close-btn:hover {
    background-color: rgba(0, 255, 255, 0.15);
}
